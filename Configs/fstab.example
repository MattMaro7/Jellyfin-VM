# /etc/fstab: static file system information.
#
# Use 'blkid' to print the universally unique identifier for a
# device; this may be used with UUID= as a more robust way to name devices
# that works even if disks are added and removed. See fstab(5).
#
# systemd generates mount units based on this file, see systemd.mount(5).
# Please run 'systemctl daemon-reload' after making changes here.
#
# <file system>                           <mount point>         <type>       <options>          <dump> <pass>

# / was on /dev/sda1 during installation
UUID=fdfcc050-258d-0000-0000-000000000000 /                     ext4         errors=remount-ro  0      1

# /srv was on /dev/sda7 during installation
UUID=900a3702-b99b-0000-0000-000000000000 /srv                  ext4         defaults           0      2

# /var was on /dev/sda5 during installation
UUID=96361430-6058-0000-0000-000000000000 /var                  ext4         defaults           0      2

# swap was on /dev/sda6 during installation
UUID=41f68c2c-9087-0000-0000-000000000000 none                  swap         sw                 0      0

# Optical drive
/dev/sr0                                  /media/cdrom0         udf,iso9660  user,noauto        0      0

# Media disk & Jellyfin bind mounts
UUID=996e1156-9612-0000-0000-000000000000 /mnt/mediadisk        ext4         defaults           0      2
/mnt/mediadisk/jellyfin-data              /var/lib/jellyfin     none         bind               0      0
/mnt/mediadisk/jellyfin-cache             /var/cache/jellyfin   none         bind               0      0
/mnt/mediadisk/media                      /srv/media            none         bind               0      0
